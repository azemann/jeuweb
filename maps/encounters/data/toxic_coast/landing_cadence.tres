[gd_resource type="Resource" script_class="EncounterData" format=3 uid="uid://b3bt8hnb4ytvs"]

[ext_resource type="Script" uid="uid://bui3dauu447sn" path="res://maps/encounters/encounter_data.gd" id="1_encounter"]
[ext_resource type="Script" uid="uid://dej2py36g0ck4" path="res://maps/encounters/wave_data.gd" id="2_wave"]
[ext_resource type="Script" uid="uid://bwvlpidgnlxln" path="res://maps/encounters/enemy_spawn_pattern_data.gd" id="3_pattern"]

[sub_resource type="Resource" id="Pattern_two_troopers"]
script = ExtResource("3_pattern")
pattern_id = &"two_troopers"
enemy_archetype = &"vacuum_trooper"
count = 2
spacing = Vector2(170, 0)
custom_offsets = PackedVector2Array()
spawn_interval = 0.15

[sub_resource type="Resource" id="Wave_pressure"]
script = ExtResource("2_wave")
wave_id = &"landing_pressure"
spawn_patterns = Array[ExtResource("3_pattern")]([SubResource("Pattern_two_troopers")])
lead_in_delay = 0.1

[sub_resource type="Resource" id="Pattern_grunt_release"]
script = ExtResource("3_pattern")
pattern_id = &"grunt_release"
local_offset = Vector2(40, 0)
custom_offsets = PackedVector2Array()

[sub_resource type="Resource" id="Wave_release"]
script = ExtResource("2_wave")
wave_id = &"landing_release"
combat_beat = 1
spawn_patterns = Array[ExtResource("3_pattern")]([SubResource("Pattern_grunt_release")])
lead_in_delay = 0.8

[resource]
script = ExtResource("1_encounter")
cadence_id = &"toxic_coast_landing_cadence"
blocks_mission_exit = false
completion_delay = 0.35
waves = Array[ExtResource("2_wave")]([SubResource("Wave_pressure"), SubResource("Wave_release")])
